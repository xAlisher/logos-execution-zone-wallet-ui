#include <QVariantList>
#include <QVariantMap>

class LEZWalletBackend
{
    PROP(bool isWalletOpen READONLY)
    PROP(bool isStartupResolved READONLY)
    // A wallet is saved here and waits for its password to open.
    PROP(bool needsPassword READONLY)
    PROP(QString configPath READONLY)
    PROP(QString storagePath READONLY)
    PROP(QString notice READONLY)
    PROP(int lastSyncedBlock READONLY)
    PROP(int currentBlockHeight READONLY)
    PROP(QString sequencerAddr READONLY)
    PROP(QString testnetUrl READONLY)
    PROP(QString localhostUrl READONLY)
    PROP(QString devnetUrl READONLY)
    // Why the wallet isn't keeping up with the chain, in words; "" when it is.
    PROP(QString syncProblem READONLY)

    SLOT(QString createAccountPublic())
    SLOT(QString createAccountPrivate())
    SLOT(void refreshAccounts())
    SLOT(QString getBalance(QString accountIdHex, bool isPublic))
    SLOT(void refreshBalances())
    SLOT(QString getPublicAccountKey(QString accountIdHex))
    SLOT(QString getPrivateAccountKeys(QString accountIdHex))
    SLOT(bool syncToBlock(quint64 blockId))

    SLOT(QString transferPublic(QString fromHex, QString toHex, QString amountStr))
    SLOT(QString transferPrivate(QString fromHex, QString toHex, QString amountStr))
    SLOT(QString transferPrivateOwned(QString fromHex, QString toHex, QString amountStr))
    SLOT(QString transferShielded(QString fromHex, QString toKeysJson, QString amountStr))
    SLOT(QString transferShieldedOwned(QString fromHex, QString toHex, QString amountStr))
    SLOT(QString transferDeshielded(QString fromHex, QString toHex, QString amountStr))

    SLOT(QString bridgeWithdraw(QString fromHex, QString bedrockAccountPkHex, QString amountStr))

    SLOT(QString createNew(QString password, QString sequencerAddr))
    SLOT(QString openExisting(QString configPath, QString storagePath, QString password))
    // Open the saved wallet: "" on success, else why not, in words.
    SLOT(QString unlockSaved(QString password))
    // Where lez_core keeps its default wallet (config.json and storage.json inside).
    SLOT(QString defaultWalletDirectory())

    SLOT(void copyToClipboard(QString text))

    SLOT(bool checkLabelAvailable(QString label))
    SLOT(QString addLabel(QString label, QString accountIdHex, bool isPublic))

    // ---- Explorer (the LEZ app's Explorer tab; logic in explorer/ExplorerService) ----
    // Recent blocks, newest first; the 2 s tip poll prepends, "Load more" appends.
    PROP(QVariantList explorerRecentBlocks READONLY)
    PROP(qlonglong explorerChainHeight=0 READONLY)
    // "Connecting" / "Connected" / "Error".
    PROP(QString explorerConnectionStatus READONLY)
    // { state: Stopped|Starting|Syncing|CaughtUp|Error|Stalled, blockId, error }.
    PROP(QVariantMap explorerSyncStatus READONLY)
    // The read-only sequencer's config JSON in effect, and the built-in default.
    PROP(QString explorerConfigText READONLY)
    PROP(QString explorerDefaultConfig READONLY)

    SLOT(bool explorerApplyConfigJson(QString json))
    SLOT(bool explorerResetSequencerCache())
    SLOT(void explorerRefreshBlocks())
    SLOT(void explorerLoadMoreBlocks())
    SLOT(QVariantMap explorerGetBlockById(QString id))
    SLOT(QVariantMap explorerGetBlockByHash(QString hash))
    SLOT(QVariantMap explorerGetTransaction(QString hash))
    SLOT(QVariantMap explorerGetAccount(QString accountId))
    SLOT(QVariantList explorerGetTransactionsByAccount(QString accountId, int offset, int limit))
    SLOT(QVariantMap explorerSearch(QString query))

    SIGNAL(explorerError(QString message))
}
